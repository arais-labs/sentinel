{
  "name": "sentinel-desktop",
  "private": true,
  "version": "2.3.0",
  "description": "Sentinel desktop management app",
  "type": "module",
  "main": "dist/main/main.js",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "desktop:build": "node scripts/packaging/desktop-build.mjs build",
    "desktop:clean": "node scripts/packaging/desktop-build.mjs clean",
    "desktop:verify": "node scripts/packaging/desktop-build.mjs verify",
    "payload:build": "node scripts/packaging/payload-build.mjs build",
    "dev": "node scripts/dev/workspace-runtime-dev.mjs && electron-vite dev --watch",
    "test": "tsc -p tsconfig.json --outDir .test-dist && node --test tests/unit/*.test.mjs",
    "test:graphics-build": "PYTHONPATH=scripts/packaging/graphics python3 -m unittest discover -s tests/unit -p 'test_*.py'",
    "build": "electron-vite build",
    "postbuild": "node --check dist/main/main.js && node --check dist/preload/preload.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "6.0.0-beta.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "us.arais.sentinel.desktop",
    "productName": "Sentinel",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "assets/icon.png",
      "dist/main/**/*",
      "dist/preload/**/*",
      "dist/renderer/**/*",
      "package.json"
    ],
    "extraResources": [],
    "mac": {
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Sentinel uses the microphone in the Voice pane to control your chats with speech."
      },
      "category": "public.app-category.developer-tools",
      "icon": "assets/icon.png",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    }
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
