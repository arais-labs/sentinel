+/*
+ * Virtio GPU has no scanout interrupt. Give the virtual monitor the same
+ * mode-driven vblank clock used by VKMS, so all DRM/Present clients receive
+ * meaningful frame counters and timestamps instead of immediate zero events.
+ * DRM starts/stops this timer with its normal vblank reference lifecycle.
+ */
+static enum hrtimer_restart virtio_gpu_vblank(struct hrtimer *timer)
+{
+	struct virtio_gpu_output *output =
+		container_of(timer, struct virtio_gpu_output, vblank_timer);
+
+	hrtimer_forward_now(timer, output->vblank_period);
+	drm_crtc_handle_vblank(&output->crtc);
+	return HRTIMER_RESTART;
+}
+
+static int virtio_gpu_enable_vblank(struct drm_crtc *crtc)
+{
+	struct virtio_gpu_output *output = drm_crtc_to_virtio_gpu_output(crtc);
+	struct drm_vblank_crtc *vblank = drm_crtc_vblank_crtc(crtc);
+
+	if (vblank->framedur_ns <= 0)
+		return -EINVAL;
+	output->vblank_period = ns_to_ktime(vblank->framedur_ns);
+	hrtimer_start(&output->vblank_timer, output->vblank_period,
+		      HRTIMER_MODE_REL);
+	return 0;
+}
+
+static void virtio_gpu_disable_vblank(struct drm_crtc *crtc)
+{
+	struct virtio_gpu_output *output = drm_crtc_to_virtio_gpu_output(crtc);
+
+	hrtimer_cancel(&output->vblank_timer);
+}
+
+static bool virtio_gpu_get_vblank_timestamp(struct drm_crtc *crtc,
+					  int *max_error, ktime_t *time,
+					  bool in_vblank_irq)
+{
+	struct virtio_gpu_output *output = drm_crtc_to_virtio_gpu_output(crtc);
+	struct drm_vblank_crtc *vblank = drm_crtc_vblank_crtc(crtc);
+
+	if (!READ_ONCE(vblank->enabled)) {
+		*time = ktime_get();
+		return true;
+	}
+	/* The timer is advanced before notifying DRM, as with hardware vblank. */
+	*time = READ_ONCE(output->vblank_timer.node.expires) - output->vblank_period;
+	return true;
+}
+
+static void virtio_gpu_crtc_destroy(struct drm_crtc *crtc)
+{
+	virtio_gpu_disable_vblank(crtc);
+	drm_crtc_cleanup(crtc);
+}
