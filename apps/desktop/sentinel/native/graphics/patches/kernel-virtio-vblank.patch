+static int virtio_gpu_add_display_mode(struct drm_connector *connector,
+				       int width, int height, bool preferred)
+{
+	struct drm_display_mode *mode, *existing;
+
+	mode = drm_cvt_mode(connector->dev, width, height,
+			    SENTINEL_DISPLAY_REFRESH_HZ, true, false, false);
+	if (!mode)
+		return 0;
+	list_for_each_entry(existing, &connector->probed_modes, head) {
+		if (drm_mode_equal(existing, mode)) {
+			if (preferred)
+				existing->type |= DRM_MODE_TYPE_PREFERRED;
+			drm_mode_destroy(connector->dev, mode);
+			return 0;
+		}
+	}
+	if (preferred)
+		mode->type |= DRM_MODE_TYPE_PREFERRED;
+	drm_mode_probed_add(connector, mode);
+	return 1;
+}
