+static bool virtio_gpu_crtc_needs_vblank(struct drm_crtc *crtc,
+				       struct drm_atomic_state *state)
+{
+	struct drm_crtc_state *crtc_state = drm_atomic_get_new_crtc_state(state, crtc);
+	struct drm_plane *plane;
+	struct drm_plane_state *old_plane, *new_plane;
+	int i;
+
+	/* Honor explicit userspace flip events and buffer lifetime changes. */
+	if (drm_atomic_crtc_needs_modeset(crtc_state) ||
+	    (crtc_state->event && crtc_state->event->base.file_priv))
+		return true;
+	for_each_oldnew_plane_in_state(state, plane, old_plane, new_plane, i) {
+		if ((old_plane->crtc == crtc || new_plane->crtc == crtc) &&
+		    (old_plane->fb != new_plane->fb || old_plane->crtc != new_plane->crtc))
+			return true;
+	}
+	/* Damage updates reuse the existing scanout; there is no old buffer
+	 * waiting to retire. Waiting here blocks Xorg for a second refresh. */
+	return false;
 }
 
