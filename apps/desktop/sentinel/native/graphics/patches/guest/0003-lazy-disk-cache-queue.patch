+TEST_F(Cache, LazyQueueLifecycle)
+{
+#ifndef ENABLE_SHADER_CACHE
+   GTEST_SKIP() << "ENABLE_SHADER_CACHE not defined.";
+#else
+   char directory[] = "./lazy-cache-XXXXXX";
+   ASSERT_NE(mkdtemp(directory), nullptr);
+   os_set_option("MESA_SHADER_CACHE_DIR", directory, true);
+   os_set_option("MESA_SHADER_CACHE_DISABLE", "false", true);
+   struct disk_cache *cache = disk_cache_create_custom("lazy", "test", 0, "lazy", 1024 * 1024);
+   ASSERT_NE(cache, nullptr);
+   ASSERT_FALSE(cache->path_init_failed);
+   EXPECT_FALSE(util_queue_is_initialized(&cache->cache_queue));
+   cache_key absent = {};
+   EXPECT_EQ(disk_cache_get(cache, absent, nullptr), nullptr);
+   disk_cache_wait_for_idle(cache);
+   EXPECT_FALSE(util_queue_is_initialized(&cache->cache_queue));
+   disk_cache_destroy(cache);
+
+   cache = disk_cache_create_custom("lazy", "test", 0, "lazy", 1024 * 1024);
+   ASSERT_NE(cache, nullptr);
+   ASSERT_FALSE(cache->path_init_failed);
+   std::vector<std::thread> writers;
+   for (unsigned i = 0; i < 32; ++i) {
+      writers.emplace_back([cache, i]() {
+         cache_key key;
+         disk_cache_compute_key(cache, &i, sizeof(i), key);
+         disk_cache_put(cache, key, &i, sizeof(i), nullptr);
+      });
+   }
+   for (auto &writer : writers)
+      writer.join();
+   disk_cache_wait_for_idle(cache);
+   EXPECT_TRUE(util_queue_is_initialized(&cache->cache_queue));
+   for (unsigned i = 0; i < 32; ++i) {
+      cache_key key;
+      disk_cache_compute_key(cache, &i, sizeof(i), key);
+      size_t size = 0;
+      void *value = disk_cache_get(cache, key, &size);
+      EXPECT_NE(value, nullptr);
+      if (value) {
+         EXPECT_EQ(size, sizeof(i));
+         if (size == sizeof(i))
+            EXPECT_EQ(memcmp(value, &i, size), 0);
+      }
+      free(value);
+   }
+   disk_cache_destroy(cache);
+   os_unset_option("MESA_SHADER_CACHE_DIR");
+   os_unset_option("MESA_SHADER_CACHE_DISABLE");
+   EXPECT_EQ(rmrf_local(directory), 0);
+#endif
+}
 
