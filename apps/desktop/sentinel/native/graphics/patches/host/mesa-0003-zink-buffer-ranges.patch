+#ifndef ZINK_BUFFER_RANGES_H
+#define ZINK_BUFFER_RANGES_H
+
+#include "pipe/p_state.h"
+#include <stdint.h>
+#include <string.h>
+
+static inline uint64_t
+zink_buffer_range_end(const struct pipe_box *box)
+{
+   return (uint64_t)(unsigned)box->x + (unsigned)box->width;
+}
+
+static inline unsigned
+zink_buffer_range_search(const struct pipe_box *boxes, unsigned count,
+                         uint64_t offset, bool adjacent)
+{
+   unsigned low = 0, high = count;
+   while (low < high) {
+      unsigned middle = low + (high - low) / 2;
+      uint64_t end = zink_buffer_range_end(&boxes[middle]);
+      if (end < offset || (!adjacent && end == offset))
+         low = middle + 1;
+      else
+         high = middle;
+   }
+   return low;
+}
+
+static inline bool
+zink_buffer_range_intersects(const struct pipe_box *boxes, unsigned count,
+                             const struct pipe_box *box)
+{
+   if (!box->width)
+      return false;
+   unsigned index = zink_buffer_range_search(boxes, count, (unsigned)box->x, false);
+   return index < count && (unsigned)boxes[index].x < zink_buffer_range_end(box);
+}
+
+static inline unsigned
+zink_buffer_range_add(struct pipe_box *boxes, unsigned count,
+                      const struct pipe_box *box)
+{
+   if (!box->width)
+      return count;
+   uint64_t start = (unsigned)box->x, end = zink_buffer_range_end(box);
+   unsigned first = zink_buffer_range_search(boxes, count, start, true);
+   unsigned last = first;
+   while (last < count && (unsigned)boxes[last].x <= end) {
+      if ((unsigned)boxes[last].x < start)
+         start = (unsigned)boxes[last].x;
+      uint64_t previous_end = zink_buffer_range_end(&boxes[last]);
+      if (previous_end > end)
+         end = previous_end;
+      last++;
+   }
+   memmove(boxes + first + 1, boxes + last, (count - last) * sizeof(*boxes));
+   boxes[first] = *box;
+   boxes[first].x = (int)start;
+   boxes[first].width = (int)(end - start);
+   return count - (last - first) + 1;
+}
+
+#endif
