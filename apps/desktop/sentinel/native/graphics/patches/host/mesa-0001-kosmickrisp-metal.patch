+   VkDevice device;
+   mtl_shared_event *event;
+};
+
+static simple_mtx_t timeline_mutex = SIMPLE_MTX_INITIALIZER;
+static struct hash_table *timeline_events;
+
+VKAPI_ATTR VkResult VKAPI_CALL
+kk_CreateSemaphore(VkDevice device, const VkSemaphoreCreateInfo *info,
+                   const VkAllocationCallbacks *allocator,
+                   VkSemaphore *semaphore)
+{
+   VkResult result =
+      vk_common_CreateSemaphore(device, info, allocator, semaphore);
+   if (result != VK_SUCCESS)
+      return result;
+
+   VK_FROM_HANDLE(vk_semaphore, sem, *semaphore);
+   if (sem->type != VK_SEMAPHORE_TYPE_TIMELINE ||
+       sem->permanent.type != &kk_sync_type)
+      return VK_SUCCESS;
+
+   struct kk_sync_timeline *sync =
+      container_of(&sem->permanent, struct kk_sync_timeline, base);
+   struct kk_metal_timeline_entry *entry =
+      CALLOC_STRUCT(kk_metal_timeline_entry);
+   if (!entry || !sync->mtl_handle) {
+      FREE(entry);
+      vk_common_DestroySemaphore(device, *semaphore, allocator);
+      *semaphore = VK_NULL_HANDLE;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   entry->device = device;
+   entry->event = sync->mtl_handle;
+
+   simple_mtx_lock(&timeline_mutex);
+   if (!timeline_events)
+      timeline_events = _mesa_hash_table_create(
+         NULL, _mesa_hash_pointer, _mesa_key_pointer_equal);
+   bool inserted = timeline_events &&
+      _mesa_hash_table_insert(timeline_events, (void *)(uintptr_t)*semaphore,
+                              entry);
+   if (!inserted && timeline_events &&
+       !_mesa_hash_table_num_entries(timeline_events)) {
+      _mesa_hash_table_destroy(timeline_events, NULL);
+      timeline_events = NULL;
+   }
+   simple_mtx_unlock(&timeline_mutex);
+   if (!inserted) {
+      FREE(entry);
+      vk_common_DestroySemaphore(device, *semaphore, allocator);
+      *semaphore = VK_NULL_HANDLE;
+      return VK_ERROR_OUT_OF_HOST_MEMORY;
+   }
+   return VK_SUCCESS;
+}
+
+VKAPI_ATTR void VKAPI_CALL
+kk_DestroySemaphore(VkDevice device, VkSemaphore semaphore,
+                    const VkAllocationCallbacks *allocator)
+{
+   if (semaphore == VK_NULL_HANDLE)
+      return;
+
+   simple_mtx_lock(&timeline_mutex);
+   if (timeline_events) {
+      struct hash_entry *entry = _mesa_hash_table_search(
+         timeline_events, (void *)(uintptr_t)semaphore);
+      if (entry) {
+         FREE(entry->data);
+         _mesa_hash_table_remove(timeline_events, entry);
+      }
+      if (!_mesa_hash_table_num_entries(timeline_events)) {
+         _mesa_hash_table_destroy(timeline_events, NULL);
+         timeline_events = NULL;
+      }
+   }
+   simple_mtx_unlock(&timeline_mutex);
+   vk_common_DestroySemaphore(device, semaphore, allocator);
+}
+
+PUBLIC VkResult
+sentinel_kk_copy_metal_timeline_event_v1(VkDevice device,
+                                      VkSemaphore semaphore, void **event)
+{
+   if (!event)
+      return VK_ERROR_INITIALIZATION_FAILED;
+   *event = NULL;
+
+   VkResult result = VK_ERROR_INVALID_EXTERNAL_HANDLE;
+   simple_mtx_lock(&timeline_mutex);
+   struct hash_entry *entry = timeline_events
+      ? _mesa_hash_table_search(timeline_events, (void *)(uintptr_t)semaphore)
+      : NULL;
+   if (entry) {
+      const struct kk_metal_timeline_entry *timeline = entry->data;
+      if (timeline->device == device) {
+         *event = mtl_retain(timeline->event);
+         result = VK_SUCCESS;
+      }
+   }
+   simple_mtx_unlock(&timeline_mutex);
+   return result;
+}
