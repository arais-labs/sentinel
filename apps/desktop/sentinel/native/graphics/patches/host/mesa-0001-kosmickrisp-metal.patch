+   VK_FROM_HANDLE(kk_cmd_buffer, cmd, commandBuffer);
+   struct kk_graphics_state *gfx = &cmd->state.gfx;
+   for (unsigned i = 0; pCounterBuffers && i < counterBufferCount; i++) {
+      VK_FROM_HANDLE(kk_buffer, buffer, pCounterBuffers[i]);
