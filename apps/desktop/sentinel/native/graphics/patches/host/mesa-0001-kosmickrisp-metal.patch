+   assert(nir_src_is_const(intr->src[1]));
+   unsigned slot = io.location + nir_src_as_uint(intr->src[1]);
+   if (slot < VARYING_SLOT_VAR0 || slot >= NUM_TOTAL_VARYING_SLOTS)
