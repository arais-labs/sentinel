+   assert(nir_src_is_const(intr->src[offset]));
+   unsigned slot = io.location + nir_src_as_uint(intr->src[offset]);
+   if (slot >= VARYING_SLOT_VAR0 && slot < NUM_TOTAL_VARYING_SLOTS)
+      components[slot] = MAX2(components[slot],
