+static bool
+kk_collect_fragment_components(nir_builder *b, nir_intrinsic_instr *intr, void *data)
+{
+   uint8_t *components = data;
+   unsigned offset;
+   if (intr->intrinsic == nir_intrinsic_load_input)
+      offset = 0;
+   else if (intr->intrinsic == nir_intrinsic_load_interpolated_input)
+      offset = 1;
+   else
