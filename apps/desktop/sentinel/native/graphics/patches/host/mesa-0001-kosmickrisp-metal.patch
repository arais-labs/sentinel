diff --git a/src/kosmickrisp/libkk/kk_geometry.cl b/src/kosmickrisp/libkk/kk_geometry.cl
--- a/src/kosmickrisp/libkk/kk_geometry.cl
+++ b/src/kosmickrisp/libkk/kk_geometry.cl
@@ -9,6 +9,87 @@
 #include "compiler/libcl/libcl_vk.h"
 #include "poly/geometry.h"
 #include "poly/tessellator.h"
+
+KERNEL(1)
+libkk_geometry_reset_counters(global uint *counters)
+{
+   for (uint i = 0; i < 17; i++)
+      counters[i] = 0;
+}
+
+KERNEL(1)
+libkk_geometry_setup_indirect(global struct poly_geometry_params *p,
+                              global struct poly_vertex_params *vp,
+                              constant uint *draw, global struct poly_heap *heap,
+                              uint prim, uint shape, uint max_indices,
+                              uint count_words, uint index_size,
+                              uint64_t index_buffer, uint index_range)
+{
+   uint vertices = draw[0], instances = draw[1];
+   uint primitives = u_decomposed_prims_for_vertices(prim, vertices);
+   ulong inputs = (ulong)vertices * instances;
+   ulong primitive_total = (ulong)primitives * instances;
+   ulong record_bytes = (ulong)p->materialized_vertex_stride_B *
+                        p->materialized_vertices_per_primitive;
+   if (inputs > UINT32_MAX || primitive_total > UINT32_MAX ||
+       record_bytes > UINT32_MAX || max_indices > UINT32_MAX / 4 ||
+       count_words > UINT32_MAX / 4 ||
+       (primitives && util_logbase2_ceil(primitives) +
+        util_logbase2_ceil(MAX2(max_indices, 1)) +
+        util_logbase2_ceil(MAX2(instances, 1)) > 31)) {
+      printf("Geometry indirect draw exceeds addressable limits\n");
+      abort();
+   }
+   ulong vertex_bytes = inputs * popcount(vp->outputs) * 16;
+   ulong count_bytes = primitive_total * count_words * 4;
+   ulong materialized_bytes = primitive_total * record_bytes;
+   ulong index_bytes = shape == POLY_GS_SHAPE_DYNAMIC_INDEXED
+                         ? primitive_total * max_indices * 4 : 0;
+   ulong required = ((vertex_bytes + 15) & ~15ul) +
+                    ((count_bytes + 15) & ~15ul) +
+                    ((materialized_bytes + 15) & ~15ul) +
+                    ((index_bytes + 15) & ~15ul);
+   if (inputs > UINT32_MAX || vertex_bytes > UINT32_MAX || count_bytes > UINT32_MAX ||
+       index_bytes > UINT32_MAX || materialized_bytes > UINT32_MAX ||
+       primitive_total > UINT32_MAX ||
+       required >= heap->size || heap->bottom >= heap->size - required) {
+      printf("Geometry indirect allocation exceeds GPU heap capacity\n");
+      abort();
+   }
+   poly_vertex_params_set_draw(vp, vertices, instances);
+   poly_geometry_params_set_draw(p, prim, shape, max_indices, vertices, instances);
+   if (index_size) {
+      vp->index_buffer = index_buffer +
+         (draw[2] < index_range ? (ulong)draw[2] * index_size : 0);
+      vp->index_buffer_range_el = poly_index_buffer_range_el(index_range, draw[2]);
+   }
+   vp->output_buffer = (uintptr_t)poly_heap_alloc(heap, vertex_bytes);
+   if (count_words)
+      p->count_buffer = poly_heap_alloc(heap, count_bytes);
+   if (materialized_bytes)
+      p->materialized_output_buffer = poly_heap_alloc(heap, materialized_bytes);
+   if (shape == POLY_GS_SHAPE_DYNAMIC_INDEXED) {
+      uint offset = poly_heap_alloc_offs(heap, index_bytes);
+      p->draw.first_index = offset / 4;
+      p->output_index_buffer = (global uint *)(heap->base + offset);
+   }
+}
+
+KERNEL(1024)
+libkk_prefix_sum_geometry(global struct poly_geometry_params *p, uint words)
+{
+   local uint scratch[32];
+   for (uint word = 0; word < words; word++) {
+      poly_prefix_sum(scratch, p->count_buffer, p->input_primitives, words, word, 1024);
+      barrier(CLK_LOCAL_MEM_FENCE | CLK_GLOBAL_MEM_FENCE);
+   }
+}
