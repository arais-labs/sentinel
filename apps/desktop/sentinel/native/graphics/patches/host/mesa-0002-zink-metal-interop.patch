diff --git a/src/gallium/drivers/zink/zink_metal_interop.h b/src/gallium/drivers/zink/zink_metal_interop.h
new file mode 100644
--- /dev/null
+++ b/src/gallium/drivers/zink/zink_metal_interop.h
@@ -0,0 +1,39 @@
+#ifndef ZINK_METAL_INTEROP_H
+#define ZINK_METAL_INTEROP_H
+
+#include <stdint.h>
+
+#define ZINK_METAL_INTEROP_MAGIC UINT32_C(0x5a4d544c)
+#define ZINK_METAL_INTEROP_VERSION 1
+#define ZINK_METAL_INTEROP_SYNC_VERSION 2
+#define ZINK_METAL_INTEROP_TEXTURE_BORROWED 1
+
+enum zink_metal_interop_status {
+   ZINK_METAL_INTEROP_SUCCESS,
+   ZINK_METAL_INTEROP_UNSUPPORTED,
+   ZINK_METAL_INTEROP_INVALID_VERSION,
+   ZINK_METAL_INTEROP_NOT_READY,
+   ZINK_METAL_INTEROP_ALLOCATION_FAILED,
+   ZINK_METAL_INTEROP_EXPORT_FAILED,
+};
+
+struct zink_metal_interop_export {
+   uint32_t magic;
+   uint32_t version;
+   uint32_t status;
+   uint32_t flags;
+   uint64_t texture;
+   uint32_t width;
+   uint32_t height;
+   uint32_t format;
+   uint32_t reserved;
+};
+
+struct zink_metal_interop_export_sync {
+   struct zink_metal_interop_export base;
+   uint64_t device;
+   uint64_t semaphore;
+   uint64_t value;
+};
+
+#endif
