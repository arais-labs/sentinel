+#ifdef VK_USE_PLATFORM_METAL_EXT
+static bool
+zink_metal_interop_use_timeline(struct zink_screen *screen,
+                              struct zink_resource *res, uint64_t *value)
+{
+   const struct zink_bo_usage usage[] = {
+      res->obj->bo->reads,
+      res->obj->bo->writes,
+   };
+   *value = 0;
+   for (unsigned i = 0; i < ARRAY_SIZE(usage); i++) {
+      struct zink_batch_usage *u = usage[i].u;
+      if (!u || zink_batch_submit_count_diff(u->submit_count, usage[i].submit_count) > 1)
+         continue;
+      struct zink_batch_state *bs = container_of(u, struct zink_batch_state, usage);
+      if (screen->threaded_submit)
+         util_queue_fence_wait(&bs->flush_completed);
+      if (zink_batch_submit_count_diff(u->submit_count, usage[i].submit_count) > 1)
+         continue;
+      if (u->unflushed || !u->usage)
+         return false;
+      *value = MAX2(*value, u->usage);
+   }
+   return true;
+}
+
+static uint32_t
+zink_metal_interop_export_object(struct pipe_screen *pscreen,
+                                 struct pipe_resource *pres,
+                                 uint32_t size, void *data,
+                                 bool *need_export_dmabuf)
+{
+   if (size < sizeof(struct zink_metal_interop_export) || !data)
+      return 0;
+
+   struct zink_metal_interop_export request;
+   memcpy(&request, data, sizeof(request));
+   if (request.magic != ZINK_METAL_INTEROP_MAGIC)
+      return 0;
+
+   *need_export_dmabuf = false;
+   struct zink_metal_interop_export out = {
+      .magic = ZINK_METAL_INTEROP_MAGIC,
+      .version = ZINK_METAL_INTEROP_VERSION,
+      .status = ZINK_METAL_INTEROP_UNSUPPORTED,
+   };
+   bool sync = request.version == ZINK_METAL_INTEROP_SYNC_VERSION;
+   uint64_t value = 0;
+   struct zink_screen *screen = zink_screen(pscreen);
+   if ((request.version != ZINK_METAL_INTEROP_VERSION && !sync) ||
+       (sync && size < sizeof(struct zink_metal_interop_export_sync))) {
+      out.status = ZINK_METAL_INTEROP_INVALID_VERSION;
+      goto done;
+   }
+   out.version = request.version;
+   struct zink_resource *res = zink_resource(pres);
+   if (pres->target != PIPE_TEXTURE_2D || pres->last_level ||
+       pres->array_size != 1 || pres->nr_samples > 1 || res->swapchain ||
+       (pres->flags & PIPE_RESOURCE_FLAG_SPARSE) ||
+       (pres->bind & (PIPE_BIND_LINEAR | PIPE_BIND_PROTECTED)) ||
+       (pres->format != PIPE_FORMAT_R8G8B8A8_UNORM &&
+        pres->format != PIPE_FORMAT_R8G8B8A8_SRGB &&
+        pres->format != PIPE_FORMAT_B8G8R8A8_UNORM &&
+        pres->format != PIPE_FORMAT_B8G8R8A8_SRGB))
+      goto done;
+
+   if (!res->obj->exportable_metal) {
+      if (res->obj->exportable || (pres->bind & PIPE_BIND_SHARED))
+         goto done;
+      if (sync && !zink_metal_interop_use_timeline(screen, res, &value)) {
+         out.status = ZINK_METAL_INTEROP_NOT_READY;
+         goto done;
+      }
+      if (zink_resource_usage_is_unflushed(res)) {
+         out.status = ZINK_METAL_INTEROP_NOT_READY;
+         goto done;
+      }
+      zink_screen_lock_context(screen);
+      if (!add_resource_bind(screen->copy_context, res, PIPE_BIND_SHARED)) {
+         zink_screen_unlock_context(screen);
+         out.status = ZINK_METAL_INTEROP_ALLOCATION_FAILED;
+         goto done;
+      }
+      if (res->all_binds)
+         p_atomic_inc(&screen->image_rebind_counter);
+      screen->copy_context->base.flush(&screen->copy_context->base, NULL, 0);
+      zink_screen_unlock_context(screen);
+   }
+
+   if (sync && !zink_metal_interop_use_timeline(screen, res, &value)) {
+      out.status = ZINK_METAL_INTEROP_NOT_READY;
+      goto done;
+   }
+
+   VkMemoryGetMetalHandleInfoEXT info = {
+      .sType = VK_STRUCTURE_TYPE_MEMORY_GET_METAL_HANDLE_INFO_EXT,
+      .memory = zink_bo_get_mem(res->obj->bo),
+      .handleType = VK_EXTERNAL_MEMORY_HANDLE_TYPE_MTLTEXTURE_BIT_EXT,
+   };
+   void *texture = NULL;
+   VkResult result = VKSCR(GetMemoryMetalHandleEXT)(screen->dev, &info, &texture);
+   if (result != VK_SUCCESS || !texture) {
+      out.status = ZINK_METAL_INTEROP_EXPORT_FAILED;
+      goto done;
+   }
+   out.status = ZINK_METAL_INTEROP_SUCCESS;
+   out.flags = ZINK_METAL_INTEROP_TEXTURE_BORROWED;
+   out.texture = (uintptr_t)texture;
+   out.width = pres->width0;
+   out.height = pres->height0;
+   out.format = zink_get_format(screen, pres->format);
+done:
+   if (sync && size >= sizeof(struct zink_metal_interop_export_sync)) {
+      struct zink_metal_interop_export_sync packet = {
+         .base = out,
+         .device = out.status == ZINK_METAL_INTEROP_SUCCESS ? (uintptr_t)screen->dev : 0,
+         .semaphore = out.status == ZINK_METAL_INTEROP_SUCCESS ? (uintptr_t)screen->sem : 0,
+         .value = out.status == ZINK_METAL_INTEROP_SUCCESS ? value : 0,
+      };
+      memcpy(data, &packet, sizeof(packet));
+      return sizeof(packet);
+   }
+   memcpy(data, &out, sizeof(out));
+   return sizeof(out);
+}
+#endif
