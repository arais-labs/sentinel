+/* WDDM2: the command travels by value in the DMA packet's private data;
+ * the KMD runs a wrong-magic or oversized body as fence-only, dropping
+ * the command, hence the size check. */
+static NTSTATUS
+virtgpu_submit_virtual(struct virtgpu *gpu,
+                       UINT type,
+                       UINT flags,
+                       UINT ring_idx,
+                       const void *payload,
+                       size_t payload_size)
+{
+   const size_t total = sizeof(VIOGPU_COMMAND_HDR) + payload_size;
+   if (total > VIOGPU_DMA_PRIV_BODY_MAX) {
+      vn_log(gpu->instance, "command too large for a DMA packet (%zu > %u)",
+             total, VIOGPU_DMA_PRIV_BODY_MAX);
+      return STATUS_BUFFER_TOO_SMALL;
+   }
+
