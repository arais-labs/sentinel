+/* WDDM2: sets the event once all DMA queued on the context so far has
+ * retired -- a queued monitored-fence signal retires after it, and an
+ * asynchronous CPU wait on that value sets the event.  Values are minted
+ * and queued under one lock: dxgkrnl refuses a GPU signal below one
+ * already queued on the context. */
+static NTSTATUS
+virtgpu_signal_virtual(struct virtgpu *gpu, HANDLE event)
+{
+   mtx_lock(&gpu->drain.lock);
+   const UINT64 value = ++gpu->drain.value;
+   D3DKMT_SIGNALSYNCHRONIZATIONOBJECTFROMGPU signal = {
+      .hContext = gpu->ctx.kmt,
+      .ObjectCount = 1,
+      .ObjectHandleArray = &gpu->drain.fence,
+      .MonitoredFenceValueArray = &value,
+   };
+   NTSTATUS status = gpu->d3dkmt.cb.signalSynchronizationObjectFromGpu(&signal);
+   mtx_unlock(&gpu->drain.lock);
+   if (!NT_SUCCESS(status))
+      return status;
+
+   D3DKMT_WAITFORSYNCHRONIZATIONOBJECTFROMCPU wait = {
+      .hDevice = gpu->d3dkmt.device,
+      .ObjectCount = 1,
+      .ObjectHandleArray = &gpu->drain.fence,
+      .FenceValueArray = &value,
+      .hAsyncEvent = event,
+   };
+   return gpu->d3dkmt.cb.waitForSynchronizationObjectFromCpu(&wait);
+}
