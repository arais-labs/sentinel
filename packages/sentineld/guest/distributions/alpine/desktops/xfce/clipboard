#!/bin/sh
# Alpine's Xfce clipboard, run by the agent as the desktop user: `write` puts stdin on the clipboard
# (xclip stays behind to serve it, its output closed so the agent is not kept waiting), `read`
# prints it, nothing when it is empty.
set -eu
case $1 in
write) exec xclip -selection clipboard -in >/dev/null 2>&1 ;;
read) xclip -selection clipboard -out 2>/dev/null || : ;;
esac
