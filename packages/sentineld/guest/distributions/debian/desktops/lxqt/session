#!/bin/sh
# Debian's LXQt session on labwc, run by session.sh as the desktop user, in a session holding the seat.
export XDG_CURRENT_DESKTOP=LXQt:labwc XDG_SESSION_DESKTOP=lxqt XDG_MENU_PREFIX=lxqt- QT_QPA_PLATFORM=wayland \
	QT_QPA_PLATFORMTHEME=lxqt XDG_CONFIG_DIRS=/etc:/etc/xdg:/usr/share XDG_DATA_DIRS=/usr/local/share:/usr/share
exec labwc -S lxqt-session
