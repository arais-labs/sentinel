# The agent runs from sentineld's read-only share, so it always matches the host (DESIGN.md §9).
[Unit]
Description=Sentinel guest agent
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
ExecStartPre=/bin/sh -c 'mkdir -p /run/sentinel && (mountpoint -q /run/sentinel || mount -t virtiofs -o ro sentinel /run/sentinel)'
ExecStart=/run/sentinel/sentineld-agent
Restart=always
RestartSec=1
OOMScoreAdjust=-1000

[Install]
WantedBy=sysinit.target
