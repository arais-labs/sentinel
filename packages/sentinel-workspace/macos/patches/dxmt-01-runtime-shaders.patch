+/* The Metal framework compiles the source (and keeps the result in its own shader cache, keyed
+ * by source and options, so later processes do not compile it again). Warnings are not errors:
+ * the error is returned only when there is no library. */
 static NTSTATUS
+_MTLDevice_newLibraryWithSource(void *obj) {
+  struct unixcall_mtldevice_newlibrarywithsource *params = obj;
+  id<MTLDevice> device = (id<MTLDevice>)params->device;
+  NSString *source = [[NSString alloc] initWithBytes:(const void *)params->source
+                                              length:params->length
+                                            encoding:NSUTF8StringEncoding];
+  MTLCompileOptions *options = [[MTLCompileOptions alloc] init];
+  options.languageVersion = MTLLanguageVersion3_0;
+  NSError *err = NULL;
+  id<MTLLibrary> library = [device newLibraryWithSource:source options:options error:&err];
+  [options release];
+  [source release];
+  params->ret_library = (obj_handle_t)library;
+  params->ret_error = library ? 0 : (obj_handle_t)[err retain];
+  return STATUS_SUCCESS;
+}
