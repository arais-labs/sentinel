dxmt: build without a Metal compiler (Xcode 26 ships it as a separate Metal Toolchain download).
The internal Metal library (dxmt_command.metal, with its constants header inlined) is embedded as
source and compiled at run time with MTLDevice newLibraryWithSource (a new winemetal call,
MTLDevice_newLibraryWithSource, unix call 139), which the Metal framework caches. airconv's helper
modules are not Metal libraries but AIR that airconv links into every converted shader: they are
kept as LLVM IR text (what Xcode's metal makes of the .metal sources, disassembled by LLVM 15) and
assembled at build time with the native LLVM's llvm-as.

diff -ruN a/meson.build b/meson.build
--- a/meson.build	2026-10-09 23:20:44
+++ b/meson.build	2026-10-13 20:56:01
@@ -151,16 +151,20 @@
   metal_air_target = '--target=air64-apple-macos13.0'
 endif
 
-xcrun = find_program('xcrun')
+# No Metal compiler at build time (Xcode's Metal Toolchain is a separate download): the internal
+# Metal library (src/dxmt/dxmt_command.metal) is embedded as source and compiled by the Metal
+# framework at run time, and airconv's helper modules, AIR that it links into converted shaders,
+# are kept as LLVM IR text (src/airconv/shaders/*.ll, made from their .metal sources) that the
+# native LLVM's llvm-as assembles.
+native_llvm_bin = get_option('native_llvm_path')
+if not native_llvm_bin.startswith('/')
+  native_llvm_bin = join_paths(meson.project_source_root(), native_llvm_bin)
+endif
+llvm_as = find_program(join_paths(native_llvm_bin, 'bin', 'llvm-as'))
 
-metalir_generator = generator(xcrun,
+airbc_generator = generator(llvm_as,
   output    : [ '@BASENAME@.air'],
-  arguments : [ '-sdk', metal_sdk, 'metal', '-o', '@OUTPUT@', '-c', '@INPUT@', '@EXTRA_ARGS@'],
-)
-
-metallib_generator = generator(xcrun,
-  output    : [ '@BASENAME@.metallib'],
-  arguments : [ '-sdk', metal_sdk, 'metallib', '-o', '@OUTPUT@', '@INPUT@'],
+  arguments : [ '-o', '@OUTPUT@', '@INPUT@'],
 )
 
 xxd = find_program('xxd')
