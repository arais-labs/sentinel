+    // A driver resets the device before letting it go and waits for it (Windows' viogpudo, on a
+    // driver restart or power-down). A 2D GPU ends its threads and resources and starts afresh on
+    // the next activation; a 3D one does not reset: its blobs stay mapped into the guest.
+    fn reset(&mut self) -> bool {
+        if self.shm_region.is_some() {
+            return false;
+        }
+        let Some(threads) = self.threads.take() else {
+            return false;
+        };
+        threads.stop.store(true, Ordering::Release);
+        for evt in &threads.wake {
+            if let Err(e) = evt.write(1) {
+                error!("gpu: cannot wake a thread to stop: {e:?}");
+            }
+        }
+        for handle in threads.handles {
+            if handle.join().is_err() {
+                error!("gpu: a thread panicked");
+            }
+        }
+        self.device_state = DeviceState::Inactive;
+        true
+    }
