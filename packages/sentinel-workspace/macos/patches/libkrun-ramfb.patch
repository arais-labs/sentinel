diff -ruN a/src/devices/src/ramfb.rs b/src/devices/src/ramfb.rs
--- a/src/devices/src/ramfb.rs	1969-12-31 18:00:00
+++ b/src/devices/src/ramfb.rs	2026-10-12 22:06:42
@@ -0,0 +1,173 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! A boot framebuffer (QEMU's ramfb model): the guest firmware allocates the framebuffer in guest
+//! RAM and programs its address and geometry through a register page; its pixels are then shown on
+//! the display backend's first scanout, from a presenter thread, about 60 times a second. An OS
+//! without a GPU driver keeps drawing into the same memory (Windows' basic display driver).
+
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::Duration;
+
+use krun_display::{DisplayBackend, DisplayBackendBasicFramebuffer, ResourceFormat};
+use log::{debug, warn};
+use vm_memory::{Bytes, GuestAddress, GuestMemoryMmap};
+
+use crate::bus::BusDevice;
+
+/// The register page: written by the firmware, `ENABLE` last; `MAX_*` tell it the display's size.
+pub const RAMFB_REGS_SIZE: u64 = 0x1000;
+const ADDRESS_LOW: u64 = 0x00;
+const ADDRESS_HIGH: u64 = 0x04;
+const WIDTH: u64 = 0x08;
+const HEIGHT: u64 = 0x0c;
+const STRIDE: u64 = 0x10;
+const FORMAT: u64 = 0x14;
+const ENABLE: u64 = 0x18;
+const MAX_WIDTH: u64 = 0x20;
+const MAX_HEIGHT: u64 = 0x24;
+/// DRM_FORMAT_XRGB8888: B, G, R, X bytes in memory (UEFI's PixelBlueGreenRedReserved8BitPerColor).
+const FOURCC_XRGB8888: u32 = 0x3432_5258;
+const FRAME_INTERVAL: Duration = Duration::from_millis(16);
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+struct Config {
+    address: u64,
+    width: u32,
+    height: u32,
+    stride: u32,
+    format: u32,
+}
+
+pub struct Ramfb {
+    staged: Config,
+    max_width: u32,
+    max_height: u32,
+    shown: Arc<Mutex<Option<Config>>>,
+    presenter: Option<(DisplayBackend<'static>, GuestMemoryMmap)>,
+}
+
+impl Ramfb {
+    pub fn new(backend: DisplayBackend<'static>, mem: GuestMemoryMmap, max_width: u32, max_height: u32) -> Self {
+        Self {
+            staged: Config::default(),
+            max_width,
+            max_height,
+            shown: Arc::new(Mutex::new(None)),
+            presenter: Some((backend, mem)),
+        }
+    }
+
+    fn enable(&mut self) {
+        let c = self.staged;
+        if c.format != FOURCC_XRGB8888
+            || c.width == 0
+            || c.height == 0
+            || c.width > self.max_width
+            || c.height > self.max_height
+            || (c.stride as u64) < c.width as u64 * 4
+        {
+            warn!("ramfb: unsupported configuration {c:?}");
+            return;
+        }
+        debug!("ramfb: {c:?}");
+        *self.shown.lock().unwrap() = Some(c);
+        if let Some((backend, mem)) = self.presenter.take() {
+            let shown = self.shown.clone();
+            let (max_width, max_height) = (self.max_width, self.max_height);
+            thread::Builder::new()
+                .name("ramfb".into())
+                .spawn(move || present(backend, mem, shown, max_width, max_height))
+                .expect("ramfb presenter thread");
+        }
+    }
+}
+
+// Shows the framebuffer whenever its pixels change; the backend instance lives on this thread.
+fn present(
+    backend: DisplayBackend<'static>,
+    mem: GuestMemoryMmap,
+    shown: Arc<Mutex<Option<Config>>>,
+    max_width: u32,
+    max_height: u32,
+) {
+    let mut display = match backend.create_instance() {
+        Ok(display) => display,
+        Err(e) => return warn!("ramfb: no display backend instance: {e:?}"),
+    };
+    let mut configured = None;
+    let mut pixels = Vec::new();
+    let mut last = Vec::new();
+    loop {
+        thread::sleep(FRAME_INTERVAL);
+        let Some(c) = *shown.lock().unwrap() else { continue };
+        if configured != Some(c) {
+            if let Err(e) = display.configure_scanout(0, max_width, max_height, c.width, c.height, ResourceFormat::BGRX) {
+                warn!("ramfb: configure scanout: {e:?}");
+                continue;
+            }
+            configured = Some(c);
+            last.clear();
+        }
+        let row = c.width as usize * 4;
+        pixels.resize(row * c.height as usize, 0);
+        let mut readable = true;
+        for y in 0..c.height as usize {
+            let at = GuestAddress(c.address + y as u64 * c.stride as u64);
+            if mem.read_slice(&mut pixels[y * row..(y + 1) * row], at).is_err() {
+                readable = false;
+                break;
+            }
+        }
+        if !readable || pixels == last {
+            continue;
+        }
+        match display.alloc_frame(0) {
+            Ok((frame, buffer)) => {
+                let n = buffer.len().min(pixels.len());
+                buffer[..n].copy_from_slice(&pixels[..n]);
+                if let Err(e) = display.present_frame(0, frame, None) {
+                    warn!("ramfb: present: {e:?}");
+                }
+                std::mem::swap(&mut last, &mut pixels);
+            }
+            Err(e) => debug!("ramfb: no frame: {e:?}"),
+        }
+    }
+}
+
+impl BusDevice for Ramfb {
+    fn read(&mut self, _vcpuid: u64, offset: u64, data: &mut [u8]) {
+        let value = match offset {
+            ADDRESS_LOW => self.staged.address as u32,
+            ADDRESS_HIGH => (self.staged.address >> 32) as u32,
+            WIDTH => self.staged.width,
+            HEIGHT => self.staged.height,
+            STRIDE => self.staged.stride,
+            FORMAT => self.staged.format,
+            MAX_WIDTH => self.max_width,
+            MAX_HEIGHT => self.max_height,
+            _ => 0,
+        };
+        let bytes = value.to_le_bytes();
+        let n = data.len().min(4);
+        data[..n].copy_from_slice(&bytes[..n]);
+    }
+
+    fn write(&mut self, _vcpuid: u64, offset: u64, data: &[u8]) {
+        if data.len() != 4 {
+            return;
+        }
+        let value = u32::from_le_bytes(data.try_into().unwrap());
+        match offset {
+            ADDRESS_LOW => self.staged.address = (self.staged.address & !0xffff_ffff) | value as u64,
+            ADDRESS_HIGH => self.staged.address = (self.staged.address & 0xffff_ffff) | (value as u64) << 32,
+            WIDTH => self.staged.width = value,
+            HEIGHT => self.staged.height = value,
+            STRIDE => self.staged.stride = value,
+            FORMAT => self.staged.format = value,
+            ENABLE if value == 1 => self.enable(),
+            _ => {}
+        }
+    }
+}
