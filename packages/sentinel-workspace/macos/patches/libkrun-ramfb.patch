+/// A boot framebuffer (devices::ramfb) shown on the backend's first display: the screen of a guest
+/// without a virtio-gpu driver, programmed by the firmware.
+#[cfg(all(feature = "gpu", target_os = "macos", target_arch = "aarch64"))]
+pub struct RamfbDevice {
+    backend: DisplayBackend,
+}
+
+#[cfg_attr(feature = "ffi", ffier::export(cfg = "all(feature = \"gpu\", target_os = \"macos\", target_arch = \"aarch64\")"))]
+#[cfg_attr(not(feature = "ffi"), cfg(all(feature = "gpu", target_os = "macos", target_arch = "aarch64")))]
+impl RamfbDevice {
+    pub fn new(backend: DisplayBackend) -> Self {
+        Self { backend }
+    }
+}
+
+#[cfg_attr(feature = "ffi", ffier::export(cfg = "all(feature = \"gpu\", target_os = \"macos\", target_arch = \"aarch64\")"))]
+#[cfg_attr(not(feature = "ffi"), cfg(all(feature = "gpu", target_os = "macos", target_arch = "aarch64")))]
+impl<'a> AttachDevice<'a> for RamfbDevice {
+    #[cfg_attr(feature = "ffi", ffier(skip))]
+    fn requirements(&self) -> DeviceRequirements {
+        DeviceRequirements::default()
+    }
+
+    #[cfg_attr(feature = "ffi", ffier(skip))]
+    fn attach(self: Box<Self>, ctx: &mut AttachContext) -> Result<(), VmmError> {
+        let display = self
+            .backend
+            .displays
+            .first()
+            .ok_or_else(|| VmmError::Internal("ramfb: the display backend has no display".into()))?;
+        let ramfb = devices::ramfb::Ramfb::new(
+            self.backend.inner,
+            ctx.guest_memory().clone(),
+            display.width,
+            display.height,
+        );
+        let base = arch::aarch64::layout::RAMFB_START;
+        ctx.vmm
+            .mmio_device_manager
+            .bus
+            .insert(Arc::new(Mutex::new(ramfb)), base, devices::ramfb::RAMFB_REGS_SIZE)
+            .map_err(|e| VmmError::Internal(format!("ramfb: {e:?}")))?;
+        ctx.vmm.ramfb = Some(base);
+        Ok(())
+    }
+}
+
