+// PMU and self-hosted debug registers read as zero and ignore writes: the guest
+// sees a PMU with no event counters and no breakpoints, which every OS accepts.
+pub fn is_raz_wi_sysreg(reg: u32) -> bool {
+    let (op0, op1, crn, crm) = (
+        sysreg_op0(reg),
+        sysreg_op1(reg),
+        sysreg_crn(reg),
+        sysreg_crm(reg),
+    );
+    let pmu = op0 == 3
+        && ((op1 == 3 && crn == 9 && (12..=14).contains(&crm))
+            || (op1 == 3 && crn == 14 && crm >= 8)
+            || (op1 == 0 && crn == 9 && crm == 14));
+    let debug = op0 == 2 && op1 == 0 && (crn == 0 || crn == 1 || crn == 7);
+    pmu || debug
+}
+
 pub fn sysreg_op0(sysreg: u32) -> u32 {
     (sysreg >> SYSREG_OP0_SHIFT) & SYSREG_OP0_MASK
 }
