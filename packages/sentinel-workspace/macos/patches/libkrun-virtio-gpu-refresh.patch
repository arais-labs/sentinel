+/// A display's refresh rate, changed while the VM runs (DisplayBackend::refresh).
+#[cfg(any(feature = "gpu", feature = "vhost-user"))]
+pub struct DisplayRefresh {
+    pub(crate) inner: Arc<devices::display::LiveRefresh>,
+}
+
+#[cfg_attr(
+    feature = "ffi",
+    ffier::export(cfg = "any(feature = \"gpu\", feature = \"vhost-user\")")
+)]
+#[cfg_attr(
+    not(feature = "ffi"),
+    cfg(any(feature = "gpu", feature = "vhost-user"))
+)]
+impl DisplayRefresh {
+    /// The new rate in hertz (1 to 1000).
+    pub fn set(&self, hz: u32) -> Result<(), VmmError> {
+        if !(1..=1000).contains(&hz) {
+            return Err(VmmError::InvalidParam());
+        }
+        self.inner.set(hz);
+        Ok(())
+    }
+}
