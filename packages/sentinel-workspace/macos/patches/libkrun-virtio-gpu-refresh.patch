+/// A display's refresh rate as the host shows it now (the screen its picture is on), which the host
+/// changes while the guest runs: the display's EDID says it, and a GPU device in use tells its guest
+/// (VIRTIO_GPU_EVENT_DISPLAY), whose desktop takes the new mode as its own display handling does.
+#[derive(Default)]
+pub struct LiveRefresh {
+    hz: AtomicU32, // 0: the EDID parameters' own
+    notify: Mutex<Option<Arc<dyn Fn() + Send + Sync>>>,
+}
+
+impl std::fmt::Debug for LiveRefresh {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        f.debug_struct("LiveRefresh").field("hz", &self.get()).finish()
+    }
+}
+
+impl LiveRefresh {
+    pub fn get(&self) -> u32 {
+        self.hz.load(Ordering::Acquire)
+    }
+
+    /// A new rate (the one the display already has changes nothing); the device in use, if any,
+    /// tells its guest.
+    pub fn set(&self, hz: u32) {
+        if self.hz.swap(hz, Ordering::AcqRel) == hz {
+            return;
+        }
+        if let Some(notify) = self.notify.lock().unwrap().clone() {
+            notify();
+        }
+    }
+
+    /// What a change does: set by the device that shows the display while it is active.
+    pub fn on_change(&self, notify: Option<Arc<dyn Fn() + Send + Sync>>) {
+        *self.notify.lock().unwrap() = notify;
+    }
+}
