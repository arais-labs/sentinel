+    /// The display's next refresh after now, on a clock that started with the worker.
+    fn next_refresh(&self) -> Instant {
+        let hz = self.displays.first().map_or(60, |d| match d.refresh.get() {
+            0 => match &d.edid {
+                crate::display::DisplayInfoEdid::Generated(p) => p.refresh_rate,
+                crate::display::DisplayInfoEdid::Provided(_) => 60,
+            },
+            hz => hz,
+        });
+        let period = Duration::from_nanos(1_000_000_000 / u64::from(hz.max(1)));
+        let ticks = self.refresh_epoch.elapsed().as_nanos() / period.as_nanos() + 1;
+        self.refresh_epoch + period * ticks as u32
+    }
+
+    /// Answers the held screen updates whose refresh has come.
+    fn answer_paced(&mut self) {
+        let mem = self.mem.clone();
+        let now = Instant::now();
+        let mut used = false;
+        while let Some(&(index, len, due)) = self.paced.front() {
+            if due > now {
+                break;
+            }
+            self.paced.pop_front();
+            if let Err(e) = self.control_queue.lock().unwrap().add_used(&mem, index, len) {
+                error!("failed to add used elements to the queue: {e:?}");
+            }
+            used = true;
+        }
+        if used && let Err(e) = self.interrupt.try_signal_used_queue() {
+            error!("Error signaling queue: {e:?}");
+        }
+    }
