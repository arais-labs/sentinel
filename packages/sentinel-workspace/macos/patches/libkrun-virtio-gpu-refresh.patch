+    /// The refresh rate of display `index`, which the caller changes while the VM runs (the host
+    /// screen it is shown on): its EDID says the new rate, and the GPU tells its guest.
+    pub fn refresh(&self, index: u32) -> Result<DisplayRefresh, VmmError> {
+        let display = self.displays.get(index as usize).ok_or(VmmError::InvalidParam())?;
+        Ok(DisplayRefresh {
+            inner: display.refresh.clone(),
+        })
+    }
