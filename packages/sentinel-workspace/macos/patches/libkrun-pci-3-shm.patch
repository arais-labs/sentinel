+/// The device's shared memory region as BAR 2: guest memory at a fixed guest-physical address
+/// (the device maps host memory into it there), which the host bridge's 64-bit window holds
+/// exactly, so the BAR's one valid assignment is that address. The register itself behaves as
+/// any BAR's: sizing probes, then the address the firmware or OS assigns.
+struct ShmBar {
+    index: u8,
+    base: u64,
+    size: u64,
+    value: u64,
+    probe: [bool; 2],
+}
+
+impl ShmBar {
+    fn register(&self, half: usize) -> u32 {
+        let value = if self.probe[half] {
+            !(self.size - 1)
+        } else {
+            self.value
+        };
+        let word = (value >> (half as u32 * u32::BITS)) as u32;
+        if half == 0 {
+            (word & PCI_BAR_ADDRESS_MASK) | PCI_BAR_MEMORY_64 | PCI_BAR_PREFETCHABLE
+        } else {
+            word
+        }
+    }
+
+    fn write(&mut self, offset: usize, data: &[u8]) {
+        if data.len() == DWORD_SIZE && offset.is_multiple_of(DWORD_SIZE) {
+            let half = offset / DWORD_SIZE;
+            if u32::from_le_bytes(data.try_into().unwrap()) == PCI_BAR_PROBE_VALUE {
+                self.probe[half] = true;
+                return;
+            }
+        }
+        let mut bytes = self.value.to_le_bytes();
+        for (index, value) in data.iter().enumerate() {
+            if let Some(byte) = bytes.get_mut(offset + index) {
+                *byte = *value;
+                self.probe[(offset + index) / DWORD_SIZE] = false;
+            }
+        }
+        self.value = u64::from_le_bytes(bytes) & !(self.size - 1);
+        // Both halves written: an address the device does not map at leaves the region unreachable.
+        if offset + data.len() > DWORD_SIZE && self.value != 0 && self.value != self.base {
+            error!(
+                "virtio-pci shared memory BAR moved to 0x{:x}; the device maps it at 0x{:x}",
+                self.value, self.base
+            );
+        }
+    }
 }
 
