+    #[test]
+    fn shared_memory_region_is_a_64bit_bar_with_its_capability() {
+        const BASE: u64 = 0x2_0000_0000;
+        const SIZE: u64 = 0x4000_0000;
+        let mem =
+            GuestMemoryMmap::from_ranges(&[(GuestAddress(0), TEST_GUEST_MEMORY_SIZE)]).unwrap();
+        let region = super::super::VirtioShmRegion {
+            host_addr: 0,
+            guest_addr: BASE,
+            size: SIZE as usize,
+        };
+        let mut transport = VirtioPciTransport::new(
+            mem,
+            Arc::new(Mutex::new(ShmDevice(region))),
+            5,
+            Arc::new(DummyIntxLine::default()),
+            TEST_BAR_BASE,
+        )
+        .unwrap();
+        let mut dword = [0u8; DWORD_SIZE];
+        let bar = |index: u16| pci_config::BAR0 as u16 + index * DWORD_SIZE as u16;
+
+        read_config(&mut transport, bar(0), &mut dword);
+        assert_eq!(u32::from_le_bytes(dword), 0, "a display device leaves BAR 0 free");
+        read_config(&mut transport, bar(2), &mut dword);
+        assert_eq!(u32::from_le_bytes(dword), TEST_BAR_BASE);
+
+        let flags = PCI_BAR_MEMORY_64 | PCI_BAR_PREFETCHABLE;
+        read_config(&mut transport, bar(4), &mut dword);
+        assert_eq!(u32::from_le_bytes(dword), BASE as u32 | flags);
+        read_config(&mut transport, bar(5), &mut dword);
+        assert_eq!(u32::from_le_bytes(dword), (BASE >> 32) as u32);
+        write_config(&mut transport, bar(4), &u32::MAX.to_le_bytes());
+        write_config(&mut transport, bar(5), &u32::MAX.to_le_bytes());
+        read_config(&mut transport, bar(4), &mut dword);
+        assert_eq!(u32::from_le_bytes(dword), !(SIZE as u32 - 1) | flags);
+        read_config(&mut transport, bar(5), &mut dword);
+        assert_eq!(u32::from_le_bytes(dword), u32::MAX);
+        write_config(&mut transport, bar(4), &(BASE as u32).to_le_bytes());
+        write_config(&mut transport, bar(5), &((BASE >> 32) as u32).to_le_bytes());
+        read_config(&mut transport, bar(5), &mut dword);
+        assert_eq!(u32::from_le_bytes(dword), (BASE >> 32) as u32);
+
+        let mut offset = [0u8];
+        read_config(&mut transport, pci_config::CAPABILITY_POINTER as u16, &mut offset);
+        let mut found = false;
+        while offset[0] != 0 {
+            let cap = u16::from(offset[0]);
+            let mut header = [0u8; 8];
+            read_config(&mut transport, cap, &mut header);
+            if header[vendor_cap::CONFIG_TYPE] == VIRTIO_PCI_CAP_SHARED_MEMORY_CFG {
+                assert_eq!(header[vendor_cap::LENGTH], VIRTIO_PCI_CAP64_LENGTH);
+                assert_eq!(header[vendor_cap::BAR], 4);
+                assert_eq!(header[vendor_cap::REGION_ID], VIRTIO_GPU_SHM_ID_HOST_VISIBLE);
+                read_config(&mut transport, cap + vendor_cap::REGION_LENGTH as u16, &mut dword);
+                assert_eq!(u32::from_le_bytes(dword), SIZE as u32);
+                read_config(&mut transport, cap + vendor_cap::REGION_LENGTH_HIGH as u16, &mut dword);
+                assert_eq!(u32::from_le_bytes(dword), (SIZE >> 32) as u32);
+                found = true;
+            } else {
+                assert_eq!(header[vendor_cap::BAR], 2, "the registers are BAR 2");
+            }
+            offset[0] = header[vendor_cap::NEXT];
+        }
+        assert!(found);
+    }
 }
