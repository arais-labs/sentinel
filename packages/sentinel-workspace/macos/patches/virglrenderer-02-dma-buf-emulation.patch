+/* Wraps the mapping of an shm resource (attached to this context) for a host memory import.
+ * The resource owns the mapping (fd -1); it outlives the import while the guest holds both.
+ */
+static struct vkr_shm *
+vkr_shm_borrow(void *data, uint64_t size)
+{
+   const size_t page_size = getpagesize();
+   struct vkr_shm *shm = calloc(1, sizeof(*shm));
+   if (!shm)
+      return NULL;
+   shm->fd = -1;
+   shm->ptr = data;
+   shm->size = (size + page_size - 1) & ~(page_size - 1);
+   return shm;
+}
+
 static void
 vkr_shm_free(struct vkr_shm *shm)
 {
    if (!shm)
       return;
 
-   munmap(shm->ptr, shm->size);
-   close(shm->fd);
+   if (shm->fd >= 0) {
+      munmap(shm->ptr, shm->size);
+      close(shm->fd);
+   }
    free(shm);
 }
 
