--- b/src/venus/vkr_physical_device.h	2026-10-11 02:04:57
+++ c/src/venus/vkr_physical_device.h	2026-10-11 02:38:28
@@ -56,4 +56,44 @@
 vkr_physical_device_destroy(struct vkr_context *ctx,
                             struct vkr_physical_device *physical_dev);
 
+/* With use_host_memory_import, dma_buf and opaque fd memory is emulated with shm: the guest
+ * sees the handle types, the driver never does.
+ */
+/* ... and image tiling is described with one DRM format modifier: shareable images are linear. */
+#define VKR_DRM_FORMAT_MOD_LINEAR 0ull
+
+#define VKR_EMULATED_MEMORY_HANDLE_TYPES                                                 \
+   (VK_EXTERNAL_MEMORY_HANDLE_TYPE_DMA_BUF_BIT_EXT | VK_EXTERNAL_MEMORY_HANDLE_TYPE_OPAQUE_FD_BIT)
+
+/* Removes the emulated handle types from a VkExternalMemory{Buffer,Image}CreateInfo in a
+ * create info chain, unlinking the struct when nothing is left.
+ */
+static inline void
+vkr_strip_emulated_handle_types(const struct vkr_physical_device *physical_dev,
+                                const void *create_info,
+                                VkStructureType type)
+{
+   if (!physical_dev->use_host_memory_import)
+      return;
+   void *prev = vkr_find_prev_struct(create_info, type);
+   if (!prev)
+      return;
+   VkExternalMemoryImageCreateInfo *info = (VkExternalMemoryImageCreateInfo *)vkr_pnext_get_next(prev);
+   info->handleTypes &= ~VKR_EMULATED_MEMORY_HANDLE_TYPES;
+   if (!info->handleTypes)
+      vkr_pnext_set_next(prev, info->pNext);
+}
+
+/* The first host-visible memory type: emulated external memory lives there. */
+static inline int
+vkr_host_visible_memory_type(const struct vkr_physical_device *physical_dev)
+{
+   const VkPhysicalDeviceMemoryProperties *props = &physical_dev->memory_properties;
+   for (uint32_t i = 0; i < props->memoryTypeCount; i++) {
+      if (props->memoryTypes[i].propertyFlags & VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT)
+         return (int)i;
+   }
+   return -1;
+}
+
 #endif /* VKR_PHYSICAL_DEVICE_H */
