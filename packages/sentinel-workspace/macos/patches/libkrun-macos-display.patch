diff -ru a/src/devices/src/virtio/snd/device.rs b/src/devices/src/virtio/snd/device.rs
--- a/src/devices/src/virtio/snd/device.rs	1969-12-31 18:00:00
+++ b/src/devices/src/virtio/snd/device.rs	2026-10-12 14:35:53
@@ -0,0 +1,234 @@
+use std::collections::VecDeque;
+use std::io::{Read, Write};
+use std::os::fd::{AsRawFd, OwnedFd};
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::time::{Duration, Instant};
+
+use vm_memory::GuestMemoryMmap;
+
+use super::super::descriptor_utils::{Reader, Writer};
+use super::super::{ActivateError, ActivateResult, DeviceQueue, DeviceState, QueueConfig, VirtioDevice};
+use super::TYPE_SND;
+use crate::virtio::InterruptTransport;
+
+const VIRTIO_F_VERSION_1: u32 = 32;
+const CONTROL: usize = 0;
+const TX: usize = 2;
+static QUEUE_CONFIG: [QueueConfig; 4] = [QueueConfig::new(64), QueueConfig::new(64), QueueConfig::new(256), QueueConfig::new(64)];
+
+// Request codes and status (virtio 1.2, 5.14).
+const R_JACK_INFO: u32 = 1;
+const R_PCM_INFO: u32 = 0x100;
+const R_PCM_SET_PARAMS: u32 = 0x101;
+const R_PCM_PREPARE: u32 = 0x102;
+const R_PCM_RELEASE: u32 = 0x103;
+const R_PCM_START: u32 = 0x104;
+const R_PCM_STOP: u32 = 0x105;
+const R_CHMAP_INFO: u32 = 0x200;
+const S_OK: u32 = 0x8000;
+const S_BAD_MSG: u32 = 0x8001;
+const S_NOT_SUPP: u32 = 0x8002;
+
+const FMT_S16: u8 = 5;
+const RATE_48000: u8 = 7;
+const CHANNELS: u8 = 2;
+const BYTES_PER_SECOND: u64 = 48_000 * 4;
+
+pub struct Sound {
+    output: Option<OwnedFd>,
+    acked_features: u64,
+    device_state: DeviceState,
+    stop: Arc<AtomicBool>,
+}
+
+impl Sound {
+    /// `output` receives the stream's interleaved S16LE stereo PCM; it is made non-blocking, and
+    /// what it cannot take at once is dropped (playback never waits for the host).
+    pub fn new(output: OwnedFd) -> Self {
+        let fd = output.as_raw_fd();
+        // SAFETY: fd is owned and valid.
+        unsafe { libc::fcntl(fd, libc::F_SETFL, libc::fcntl(fd, libc::F_GETFL) | libc::O_NONBLOCK) };
+        Self { output: Some(output), acked_features: 0, device_state: DeviceState::Inactive, stop: Arc::new(AtomicBool::new(false)) }
+    }
+
+    pub fn id(&self) -> &str {
+        "snd"
+    }
+}
+
+fn le32(b: &[u8], at: usize) -> u32 {
+    b.get(at..at + 4).map_or(0, |s| u32::from_le_bytes(s.try_into().unwrap()))
+}
+
+// One item of a query-info reply, padded or cut to the size the guest asked for.
+fn item(out: &mut Vec<u8>, data: &[u8], size: usize) {
+    let n = data.len().min(size);
+    out.extend_from_slice(&data[..n]);
+    out.resize(out.len() + size - n, 0);
+}
+
+fn control(request: &[u8], flush: &mut bool) -> Vec<u8> {
+    let code = le32(request, 0);
+    let (start, count, size) = (le32(request, 4) as usize, le32(request, 8) as usize, le32(request, 12) as usize);
+    let mut reply = S_OK.to_le_bytes().to_vec();
+    match code {
+        R_JACK_INFO if start + count > 0 => reply = S_BAD_MSG.to_le_bytes().to_vec(),
+        R_JACK_INFO => {}
+        R_PCM_INFO | R_CHMAP_INFO if start + count > 1 => reply = S_BAD_MSG.to_le_bytes().to_vec(),
+        R_PCM_INFO => {
+            for _ in 0..count {
+                let mut info = Vec::with_capacity(32);
+                info.extend_from_slice(&0u32.to_le_bytes()); // hda_fn_nid
+                info.extend_from_slice(&0u32.to_le_bytes()); // features
+                info.extend_from_slice(&(1u64 << FMT_S16).to_le_bytes());
+                info.extend_from_slice(&(1u64 << RATE_48000).to_le_bytes());
+                info.extend_from_slice(&[0, CHANNELS, CHANNELS, 0, 0, 0, 0, 0]); // output, channels min/max
+                item(&mut reply, &info, size);
+            }
+        }
+        R_CHMAP_INFO => {
+            for _ in 0..count {
+                let mut info = 0u32.to_le_bytes().to_vec(); // hda_fn_nid
+                info.extend_from_slice(&[0, CHANNELS, 3, 4]); // output, 2 channels: front left, front right
+                info.resize(24, 0);
+                item(&mut reply, &info, size);
+            }
+        }
+        R_PCM_SET_PARAMS => {
+            let supported = le32(request, 4) == 0
+                && request.get(20) == Some(&CHANNELS)
+                && request.get(21) == Some(&FMT_S16)
+                && request.get(22) == Some(&RATE_48000);
+            if !supported {
+                reply = S_NOT_SUPP.to_le_bytes().to_vec();
+            }
+        }
+        R_PCM_PREPARE | R_PCM_START => {}
+        R_PCM_STOP | R_PCM_RELEASE => *flush = true, // pending buffers complete now
+        _ => reply = S_NOT_SUPP.to_le_bytes().to_vec(),
+    }
+    reply
+}
+
+fn run(mem: GuestMemoryMmap, interrupt: InterruptTransport, mut queues: Vec<DeviceQueue>, output: OwnedFd, stop: Arc<AtomicBool>) {
+    let mut pending: VecDeque<(u16, Instant)> = VecDeque::new();
+    let mut playing_until = Instant::now();
+    while !stop.load(Ordering::Relaxed) {
+        let wait = pending.front().map_or(Duration::from_millis(100), |(_, due)| due.saturating_duration_since(Instant::now()));
+        let mut fds = [CONTROL, TX].map(|q| libc::pollfd { fd: queues[q].event.as_raw_fd(), events: libc::POLLIN, revents: 0 });
+        // SAFETY: fds is a valid array of pollfd.
+        unsafe { libc::poll(fds.as_mut_ptr(), 2, wait.as_millis().min(100) as i32) };
+        let mut used = false;
+        let mut flush = false;
+
+        if fds[0].revents & libc::POLLIN != 0 {
+            let _ = queues[CONTROL].event.read();
+            while let Some(head) = queues[CONTROL].queue.pop(&mem) {
+                let (Ok(mut reader), Ok(mut writer)) = (Reader::new(&mem, head.clone()), Writer::new(&mem, head.clone())) else { continue };
+                let mut request = Vec::new();
+                let _ = reader.read_to_end(&mut request);
+                let _ = writer.write_all(&control(&request, &mut flush));
+                let _ = queues[CONTROL].queue.add_used(&mem, head.index, writer.bytes_written() as u32);
+                used = true;
+            }
+        }
+        if fds[1].revents & libc::POLLIN != 0 {
+            let _ = queues[TX].event.read();
+            while let Some(head) = queues[TX].queue.pop(&mem) {
+                let (Ok(mut reader), Ok(mut writer)) = (Reader::new(&mem, head.clone()), Writer::new(&mem, head.clone())) else { continue };
+                let mut data = Vec::new();
+                let _ = reader.read_to_end(&mut data);
+                let pcm = data.get(4..).unwrap_or_default();
+                // SAFETY: the fd is open for the device's lifetime; a short or failed write drops audio.
+                let _ = unsafe { libc::write(output.as_raw_fd(), pcm.as_ptr().cast(), pcm.len()) };
+                let mut status = S_OK.to_le_bytes().to_vec();
+                status.extend_from_slice(&0u32.to_le_bytes()); // latency_bytes
+                let _ = writer.write_all(&status);
+                let start = playing_until.max(Instant::now());
+                playing_until = start + Duration::from_micros(pcm.len() as u64 * 1_000_000 / BYTES_PER_SECOND);
+                pending.push_back((head.index, playing_until));
+            }
+        }
+        let now = Instant::now();
+        while let Some(&(index, due)) = pending.front() {
+            if !flush && due > now {
+                break;
+            }
+            pending.pop_front();
+            let _ = queues[TX].queue.add_used(&mem, index, 8);
+            used = true;
+        }
+        if flush {
+            playing_until = now;
+        }
+        if used && let Err(e) = interrupt.try_signal_used_queue() {
+            error!("snd: interrupt: {e:?}");
+        }
+    }
+}
+
+impl VirtioDevice for Sound {
+    fn avail_features(&self) -> u64 {
+        1 << VIRTIO_F_VERSION_1
+    }
+
+    fn acked_features(&self) -> u64 {
+        self.acked_features
+    }
+
+    fn set_acked_features(&mut self, acked_features: u64) {
+        self.acked_features = acked_features
+    }
+
+    fn device_type(&self) -> u32 {
+        TYPE_SND
+    }
+
+    fn device_name(&self) -> &str {
+        "snd"
+    }
+
+    fn queue_config(&self) -> &[QueueConfig] {
+        &QUEUE_CONFIG
+    }
+
+    fn read_config(&self, offset: u64, data: &mut [u8]) {
+        // jacks, streams, chmaps
+        let config: Vec<u8> = [0u32, 1, 1].iter().flat_map(|v| v.to_le_bytes()).collect();
+        let start = (offset as usize).min(config.len());
+        let n = data.len().min(config.len() - start);
+        data[..n].copy_from_slice(&config[start..start + n]);
+    }
+
+    fn write_config(&mut self, offset: u64, data: &[u8]) {
+        warn!("snd: guest wrote device config (offset={offset:x}, len={:x})", data.len());
+    }
+
+    fn activate(&mut self, mem: GuestMemoryMmap, interrupt: InterruptTransport, queues: Vec<DeviceQueue>) -> ActivateResult {
+        if queues.len() != QUEUE_CONFIG.len() {
+            return Err(ActivateError::BadActivate);
+        }
+        let output = self.output.as_ref().and_then(|fd| fd.try_clone().ok()).ok_or(ActivateError::BadActivate)?;
+        self.stop = Arc::new(AtomicBool::new(false));
+        let stop = self.stop.clone();
+        let thread_mem = mem.clone();
+        let thread_interrupt = interrupt.clone();
+        std::thread::Builder::new()
+            .name("snd".into())
+            .spawn(move || run(thread_mem, thread_interrupt, queues, output, stop))
+            .map_err(|_| ActivateError::BadActivate)?;
+        self.device_state = DeviceState::Activated(mem, interrupt);
+        Ok(())
+    }
+
+    fn is_activated(&self) -> bool {
+        self.device_state.is_activated()
+    }
+
+    fn reset(&mut self) -> bool {
+        self.stop.store(true, Ordering::Relaxed);
+        self.device_state = DeviceState::Inactive;
+        true
+    }
+}
