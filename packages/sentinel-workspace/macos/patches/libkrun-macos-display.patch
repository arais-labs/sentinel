+/// Guest memory on macOS: RAM is memory owned by this process (vstate::map_owned_memory), charged
+/// once. Ordinary anonymous memory mapped into the guest was charged twice once the host wrote
+/// into it (every disk read does), doubling the VM's reported footprint. The shared-memory windows
+/// (GPU blobs, file system DAX) stay plain mappings: blobs are mapped over them.
+#[cfg(target_os = "macos")]
+fn hvf_guest_memory(
+    ranges: &[(GuestAddress, usize)],
+    ram_regions: usize,
+) -> std::result::Result<GuestMemoryMmap, StartMicrovmError> {
+    let error = |what: String| StartMicrovmError::GuestMemoryMmap(what);
+    let mut regions = Vec::with_capacity(ranges.len());
+    for (index, &(guest_addr, size)) in ranges.iter().enumerate() {
+        let region = if index < ram_regions {
+            let host_addr = crate::vmm::vstate::map_owned_memory(None, size as u64)
+                .ok_or_else(|| error("cannot allocate guest memory".into()))?;
+            // SAFETY: the allocation is readable and writable, `size` bytes, and lives as long
+            // as the VM (it is never deallocated).
+            unsafe {
+                vm_memory::mmap::MmapRegion::build_raw(
+                    host_addr as *mut u8,
+                    size,
+                    libc::PROT_READ | libc::PROT_WRITE,
+                    libc::MAP_ANONYMOUS | libc::MAP_PRIVATE,
+                )
+            }
+            .map_err(|e| error(format!("{e:?}")))?
+        } else {
+            vm_memory::mmap::MmapRegion::new(size).map_err(|e| error(format!("{e:?}")))?
+        };
+        regions.push(
+            vm_memory::GuestRegionMmap::new(region, guest_addr)
+                .ok_or_else(|| error("guest memory region overflows".into()))?,
+        );
+    }
+    GuestMemoryMmap::from_regions(regions).map_err(|e| error(format!("{e:?}")))
+}
