+/// Guest RAM is built from owned memory in chunks of this size (the guest reports free memory in
+/// aligned blocks of at least 2 MiB). Replacing a whole chunk frees it; a part of a larger object
+/// would stay allocated as long as the rest of the object is mapped.
+pub(crate) const OWNED_CHUNK: u64 = 2 << 20;
+
+/// New zeroed memory owned by this process, at `address` (replacing what is mapped there, whose
+/// pages are freed) or anywhere (aligned to OWNED_CHUNK). Guest RAM is made of it: owned memory
+/// is charged to the VM once, however the host writes into it (plain anonymous memory mapped into
+/// the guest was charged twice once the host wrote it, e.g. on every disk read). Returns the
+/// address.
+pub(crate) fn map_owned_memory(address: Option<u64>, len: u64) -> Option<u64> {
+    const VM_PROT_RW: i32 = 0x1 | 0x2;
+    const VM_FLAGS_ANYWHERE: i32 = 0x1;
+    const VM_INHERIT_COPY: u32 = 1;
+    #[allow(deprecated)]
+    // SAFETY: Mach calls on this task's own address space; a fixed address is a range of guest
+    // RAM the guest no longer uses.
+    let task = unsafe { libc::mach_task_self() };
+    let base = match address {
+        Some(address) => address,
+        None => {
+            // Reserve the range, aligned, then fill it with owned chunks.
+            let mut reserved = 0u64;
+            // SAFETY: maps zero-fill memory anywhere in this task.
+            let ret = unsafe {
+                mach_vm_map(task, &mut reserved, len, OWNED_CHUNK - 1, VM_FLAGS_ANYWHERE, 0, 0, 0,
+                            VM_PROT_RW, VM_PROT_RW, VM_INHERIT_COPY)
+            };
+            if ret != 0 {
+                return None;
+            }
+            reserved
+        }
+    };
+    let mut offset = 0;
+    while offset < len {
+        let size = OWNED_CHUNK.min(len - offset);
+        if !map_owned_chunk(task, base + offset, size) {
+            return None;
+        }
+        offset += size;
+    }
+    Some(base)
+}
+
+// One purgeable (non-volatile: never discarded) memory object owned by this task, mapped over
+// `[address, address + size)`. The mapping holds its only reference.
+fn map_owned_chunk(task: u32, address: u64, size: u64) -> bool {
+    const MAP_MEM_NAMED_CREATE: i32 = 0x0002_0000;
+    const MAP_MEM_PURGABLE: i32 = 0x0004_0000; // ownership needs it
+    const VM_PROT_RW: i32 = 0x1 | 0x2;
+    const VM_FLAGS_OVERWRITE: i32 = 0x4000; // with VM_FLAGS_FIXED (0)
+    const VM_LEDGER_TAG_DEFAULT: i32 = 1;
+    const VM_INHERIT_COPY: u32 = 1;
+    // SAFETY: Mach calls on this task's own address space, over a range it owns.
+    unsafe {
+        let mut entry_size = size;
+        let mut entry = 0u32;
+        if mach_make_memory_entry_64(task, &mut entry_size, 0, MAP_MEM_NAMED_CREATE | MAP_MEM_PURGABLE | VM_PROT_RW,
+                                     &mut entry, 0) != 0
+        {
+            return false;
+        }
+        let mut mapped = address;
+        let ok = mach_memory_entry_ownership(entry, task, VM_LEDGER_TAG_DEFAULT, 0) == 0
+            && mach_vm_map(task, &mut mapped, size, 0, VM_FLAGS_OVERWRITE, entry, 0, 0, VM_PROT_RW, VM_PROT_RW,
+                           VM_INHERIT_COPY) == 0;
+        mach_port_deallocate(task, entry);
+        ok
     }
 }
 
