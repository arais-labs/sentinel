diff -ruN a/src/libkrun/src/vmm/device_manager/hvf/pci.rs b/src/libkrun/src/vmm/device_manager/hvf/pci.rs
--- a/src/libkrun/src/vmm/device_manager/hvf/pci.rs	1969-12-31 18:00:00
+++ b/src/libkrun/src/vmm/device_manager/hvf/pci.rs	2026-10-12 21:27:59
@@ -0,0 +1,146 @@
+// SPDX-License-Identifier: Apache-2.0
+
+//! PCI root and virtio-pci registration for the aarch64 Hypervisor.framework backend: the ECAM and
+//! the BAR window are MMIO bus devices, and each function's INTx is a level-triggered GIC SPI,
+//! allocated down from the top of the SPI range (MMIO devices take theirs from the bottom).
+
+use std::fmt::{Display, Formatter};
+use std::sync::{Arc, Mutex};
+
+use arch::aarch64::layout::{PCI_BAR_END, PCI_BAR_START, PCI_ECAM_SIZE, PCI_ECAM_START};
+use arch::aarch64::{PciFunctionInfo, PciHostInfo};
+use devices::Bus;
+use devices::legacy::IrqChip;
+use devices::pci::{BarWindow, Ecam, PciAddress, PciFunction, PciIntxLine, PciRootError};
+use devices::virtio::{
+    CreatePciTransportError, VIRTIO_PCI_BAR0_SIZE, VirtioDevice, VirtioPciTransport,
+};
+use vm_memory::GuestMemoryMmap;
+
+const PCI_BUS0: u8 = 0;
+
+#[derive(Debug)]
+pub enum Error {
+    Bus(devices::BusError),
+    CreateTransport(CreatePciTransportError),
+    IrqsExhausted,
+    PciRoot(PciRootError),
+}
+
+impl Display for Error {
+    fn fmt(&self, f: &mut Formatter<'_>) -> std::fmt::Result {
+        match self {
+            Self::Bus(err) => write!(f, "failed to register PCI bus device: {err}"),
+            Self::CreateTransport(err) => write!(f, "failed to create virtio-pci transport: {err}"),
+            Self::IrqsExhausted => write!(f, "no more PCI slots or SPIs are available"),
+            Self::PciRoot(err) => write!(f, "failed to register PCI function: {err}"),
+        }
+    }
+}
+
+type Result<T> = std::result::Result<T, Error>;
+
+/// Owns the bus-0 PCI functions and their guest address windows.
+pub struct PciHostManager {
+    root: devices::pci::SharedPciRoot,
+    next_device: u8,
+    irq: u32,
+    functions: Vec<PciFunctionInfo>,
+}
+
+struct GicIntxLine {
+    intc: IrqChip,
+    irq: u32,
+}
+
+impl PciIntxLine for GicIntxLine {
+    fn set_level(&self, asserted: bool) -> std::io::Result<()> {
+        self.intc
+            .lock()
+            .expect("Poisoned interrupt controller lock")
+            .set_irq_level(self.irq, asserted)
+            .map_err(|err| std::io::Error::other(format!("{err:?}")))
+    }
+}
+
+impl Default for PciHostManager {
+    fn default() -> Self {
+        Self::new()
+    }
+}
+
+impl PciHostManager {
+    pub fn new() -> Self {
+        Self {
+            root: devices::pci::PciRoot::shared(),
+            next_device: 1,
+            irq: arch::IRQ_MAX,
+            functions: Vec::new(),
+        }
+    }
+
+    pub fn register_mmio(&self, bus: &mut Bus) -> Result<()> {
+        bus.insert(
+            Arc::new(Mutex::new(Ecam::new(self.root.clone()))),
+            PCI_ECAM_START,
+            PCI_ECAM_SIZE,
+        )
+        .map_err(Error::Bus)?;
+        bus.insert(
+            Arc::new(Mutex::new(BarWindow::new(self.root.clone(), PCI_BAR_START))),
+            PCI_BAR_START,
+            PCI_BAR_END - PCI_BAR_START,
+        )
+        .map_err(Error::Bus)
+    }
+
+    pub fn register_virtio_device(
+        &mut self,
+        intc: IrqChip,
+        guest_memory: GuestMemoryMmap,
+        device: Arc<Mutex<dyn VirtioDevice>>,
+    ) -> Result<PciFunctionInfo> {
+        if self.irq < arch::IRQ_BASE || self.next_device > 31 {
+            return Err(Error::IrqsExhausted);
+        }
+
+        let irq = self.irq;
+        let address = PciAddress::new(PCI_BUS0, self.next_device, 0);
+        let bar_base = PCI_BAR_START + u64::from(self.next_device - 1) * VIRTIO_PCI_BAR0_SIZE;
+        if bar_base + VIRTIO_PCI_BAR0_SIZE > PCI_BAR_END {
+            return Err(Error::IrqsExhausted);
+        }
+        let intx_line = Arc::new(GicIntxLine { intc, irq });
+        let transport =
+            VirtioPciTransport::new(guest_memory, device, irq as u8, intx_line, bar_base as u32)
+                .map_err(Error::CreateTransport)?;
+
+        let function: Arc<Mutex<dyn PciFunction>> = Arc::new(Mutex::new(transport));
+        self.root
+            .lock()
+            .expect("Poisoned PCI root lock")
+            .insert(address, function)
+            .map_err(Error::PciRoot)?;
+
+        let info = PciFunctionInfo {
+            device: address.device,
+            function: address.function,
+            irq,
+        };
+        self.functions.push(info);
+        self.next_device += 1;
+        self.irq -= 1;
+        Ok(info)
+    }
+
+    /// The host bridge for the device tree; `None` when no function is on the bus.
+    pub fn host_info(&self) -> Option<PciHostInfo> {
+        (!self.functions.is_empty()).then(|| PciHostInfo {
+            ecam_base: PCI_ECAM_START,
+            ecam_size: PCI_ECAM_SIZE,
+            bar_start: PCI_BAR_START,
+            bar_size: PCI_BAR_END - PCI_BAR_START,
+            functions: self.functions.clone(),
+        })
+    }
+}
