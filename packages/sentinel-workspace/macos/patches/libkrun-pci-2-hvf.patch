+
+// A generic ECAM host bridge (bus 0): one 32-bit memory window, mapped 1:1, and per function its
+// INTA as a level-triggered SPI.
+fn create_pci_node(fdt: &mut FdtWriter, pci: &arch::aarch64::PciHostInfo) -> Result<()> {
+    const PCI_MEM32: u32 = 0x0200_0000;
+    let node = fdt.begin_node(&format!("pcie@{:x}", pci.ecam_base))?;
+    fdt.property_string("compatible", "pci-host-ecam-generic")?;
+    fdt.property_string("device_type", "pci")?;
+    fdt.property_u32("#address-cells", 3)?;
+    fdt.property_u32("#size-cells", 2)?;
+    fdt.property_u32("#interrupt-cells", 1)?;
+    fdt.property("bus-range", &generate_prop32(&[0, 0]))?;
+    fdt.property_u32("linux,pci-domain", 0)?;
+    fdt.property_null("dma-coherent")?;
+    fdt.property("reg", &generate_prop64(&[pci.ecam_base, pci.ecam_size]))?;
+    let (start, size) = (pci.bar_start, pci.bar_size);
+    fdt.property(
+        "ranges",
+        &generate_prop32(&[
+            PCI_MEM32,
+            (start >> 32) as u32,
+            start as u32,
+            (start >> 32) as u32,
+            start as u32,
+            (size >> 32) as u32,
+            size as u32,
+        ]),
+    )?;
+    let mut map = Vec::new();
+    for f in &pci.functions {
+        let devfn = (u32::from(f.device) << 11) | (u32::from(f.function) << 8);
+        #[cfg(target_os = "macos")]
+        let spi = f.irq - 32;
+        #[cfg(not(target_os = "macos"))]
+        let spi = f.irq;
+        map.extend_from_slice(&[devfn, 0, 0, 1, GIC_PHANDLE, 0, 0, GIC_FDT_IRQ_TYPE_SPI, spi, IRQ_TYPE_LEVEL_HI]);
+    }
+    fdt.property("interrupt-map", &generate_prop32(&map))?;
+    fdt.property("interrupt-map-mask", &generate_prop32(&[0xf800, 0, 0, 7]))?;
+    fdt.end_node(node)?;
     Ok(())
 }
 
