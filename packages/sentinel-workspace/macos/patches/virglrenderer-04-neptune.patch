+static void
+npt_dispatch_wait_virtqueue_seqno(struct npt_context *ctx,
+                                  struct npt_cs_decoder *dec,
+                                  const struct npt_command_header *header)
+{
+   struct npt_cmd_wait_virtqueue_seqno cmd;
