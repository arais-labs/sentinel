diff -ruN a/ArmVirtPkg/SentinelPlatformDxe/SentinelPlatformDxe.c b/ArmVirtPkg/SentinelPlatformDxe/SentinelPlatformDxe.c
--- a/ArmVirtPkg/SentinelPlatformDxe/SentinelPlatformDxe.c	1969-12-31 18:00:00
+++ b/ArmVirtPkg/SentinelPlatformDxe/SentinelPlatformDxe.c	2026-10-13 01:21:18
@@ -0,0 +1,46 @@
+/** @file
+  Sentinel's virtual machine (libkrun): the hardware is described to the OS both
+  ways, by ACPI tables generated from the device tree (DynamicTablesPkg) and by
+  the device tree itself, so each OS takes the one it uses. The UEFI variable
+  store is emulated in RAM (libkrun has no flash).
+
+  SPDX-License-Identifier: BSD-2-Clause-Patent
+**/
+
+#include <Guid/PlatformHasAcpi.h>
+#include <Guid/PlatformHasDeviceTree.h>
+#include <Library/DebugLib.h>
+#include <Library/PcdLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+
+EFI_STATUS
+EFIAPI
+SentinelPlatformDxeEntryPoint (
+  IN EFI_HANDLE        ImageHandle,
+  IN EFI_SYSTEM_TABLE  *SystemTable
+  )
+{
+  EFI_STATUS  Status;
+
+  if (PcdGetBool (PcdEmuVariableNvModeEnable)) {
+    // The driver implementing the variable service can now be dispatched.
+    Status = gBS->InstallProtocolInterface (
+                    &gImageHandle,
+                    &gEdkiiNvVarStoreFormattedGuid,
+                    EFI_NATIVE_INTERFACE,
+                    NULL
+                    );
+    ASSERT_EFI_ERROR (Status);
+  }
+
+  Status = gBS->InstallMultipleProtocolInterfaces (
+                  &ImageHandle,
+                  &gEdkiiPlatformHasAcpiGuid,
+                  NULL,
+                  &gEdkiiPlatformHasDeviceTreeGuid,
+                  NULL,
+                  NULL
+                  );
+  ASSERT_EFI_ERROR (Status);
+  return Status;
+}
